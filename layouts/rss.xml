{{- /*
  FEEDET. Dansk RSS 2.0 med forfatter, mærker som kategorier og fuld
  tekst i content:encoded.
*/ -}}
{{- $navn := site.Params.maerke | default site.Title -}}
{{- $titel := site.Params.feedTitle | default site.Title -}}
{{- $besk := site.Home.Description | default site.Params.description -}}
{{- if not $besk }}{{ $besk = printf "Nye artikler fra %s." $navn }}{{ end -}}
{{- $hele := site.Params.fuldeIndlaeg | default true -}}
{{- $sider := .RegularPages -}}
{{- if .IsHome }}{{ $sider = site.RegularPages }}{{ end -}}
{{- $graense := site.Config.Services.RSS.Limit -}}
{{- if ge $graense 1 }}{{ $sider = first $graense $sider }}{{ end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if .IsHome }}{{ $titel }}{{ else }}{{ .Title }} — {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ if .IsHome }}{{ $besk | plainify | chomp }}{{ else }}{{ printf "%s på %s." .Title $navn }}{{ end }}</description>
    <language>{{ site.Language.Locale | default site.Language.Lang }}</language>
    {{- with site.Params.author }}
    <copyright>{{ . }}</copyright>
    {{- end }}
    {{- with $sider }}
    <lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType.Type }}" />
    {{- end }}
    {{- range $sider }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- with site.Params.author }}
      <dc:creator>{{ . }}</dc:creator>
      {{- end }}
      {{- range .GetTerms "tags" }}
      <category>{{ .LinkTitle }}</category>
      {{- end }}
      <description>{{ .Description | default .Summary | plainify | chomp | html }}</description>
      {{- if $hele }}
      <content:encoded>{{ .Content | transform.XMLEscape | safeHTML }}</content:encoded>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
